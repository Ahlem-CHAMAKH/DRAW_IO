    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@playwright/test": "^1.48.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
