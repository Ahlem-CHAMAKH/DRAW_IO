{
  "name": "qualimetry",
  "version": "0.1.0",
  "description": "Record browser actions, generate test scripts, save scenarios, and replay them repeatedly — combining the best of Cypress and Selenium.",
  "type": "module",
  "bin": {
    "qualimetry": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "server": "node --experimental-sqlite dist/server/index.js",
    "dev:server": "node --experimental-sqlite --import tsx/esm src/server/index.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@playwright/test": "^1.48.0",
    "archiver": "^7.0.1",
    "commander": "^12.1.0",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/express": "^4.17.25",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
