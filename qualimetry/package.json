{
  "name": "qualimetry",
  "version": "0.1.0",
  "description": "Record browser actions, generate test scripts, save scenarios, and replay them repeatedly — combining the best of Cypress and Selenium.",
  "type": "module",
  "bin": {
    "qualimetry": "./dist/cli.js"
  },
