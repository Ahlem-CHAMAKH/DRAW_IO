{
  "manifest_version": 3,
  "name": "GOSI Qualimetry Recorder",
  "version": "0.1.0",
  "description": "Record clicks, typing, and navigation as a GOSI Qualimetry test scenario and save it to your Qualimetry server.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "webNavigation", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
